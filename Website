<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online Examination System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .mono { font-family: 'JetBrains Mono', monospace; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f8fafc; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col selection:bg-indigo-600 selection:text-white">

    <!-- TOP NAVIGATION HEADER -->
    <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-slate-200 px-4 sm:px-6 h-16 flex items-center">
        <div class="max-w-5xl w-full mx-auto flex items-center justify-between">
            <!-- Brand -->
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-sm">
                    <i class="fa-solid fa-graduation-cap text-sm"></i>
                </div>
                <span class="font-bold text-slate-900 tracking-tight text-base">ExamPortal <span class="text-xs font-medium text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full ml-1">v5</span></span>
            </div>

            <!-- Right Status & User Controls -->
            <div class="flex items-center gap-3">
                <!-- Live Countdown Pill (Only visible during an active exam) -->
                <div id="headerExamTimer" class="hidden items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900 text-white text-xs font-medium mono">
                    <i class="fa-regular fa-clock text-amber-400"></i>
                    <span id="headerTimerText">00:30:00</span>
                </div>

                <!-- Subtle Online/Offline Toggle Pill -->
                <button onclick="app.toggleNetwork()" id="netStatusPill" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium border transition bg-emerald-50 border-emerald-200 text-emerald-700 hover:bg-emerald-100" title="Click to toggle Online / Offline mode">
                    <span id="netStatusDot" class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span id="netStatusLabel">Online</span>
                </button>

                <!-- Logged-in User Badge & Logout -->
                <div id="headerUserArea" class="hidden items-center gap-3 pl-2 border-l border-slate-200">
                    <div class="text-right hidden sm:block">
                        <div id="headerUserName" class="text-xs font-semibold text-slate-800">User</div>
                        <div id="headerUserRole" class="text-[11px] text-slate-500">Role</div>
                    </div>
                    <button onclick="app.logout()" class="p-2 rounded-xl text-slate-500 hover:text-rose-600 hover:bg-rose-50 transition" title="Sign Out">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- TOAST NOTIFICATIONS -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

    <!-- MAIN WORKSPACE -->
    <main class="flex-1 flex flex-col justify-center py-8 px-4 sm:px-6">
        <div class="max-w-5xl w-full mx-auto">

            <!-- ================= VIEW 1: CLEAN LOGIN PAGE ================= -->
            <section id="viewLogin" class="max-w-md mx-auto">
                <div class="bg-white border border-slate-200/90 rounded-2xl shadow-sm p-6 sm:p-8 space-y-6">
                    <div class="text-center space-y-1.5">
                        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Sign in to Portal</h1>
                        <p class="text-xs text-slate-500">Select your role and enter your credentials to continue</p>
                    </div>

                    <!-- Role Selector Tabs -->
                    <div class="grid grid-cols-3 bg-slate-100 p-1 rounded-xl">
                        <button type="button" onclick="app.setLoginRole('Student')" id="roleTab_Student" class="py-2 rounded-lg text-xs font-semibold transition bg-white text-slate-900 shadow-sm">
                            Student
                        </button>
                        <button type="button" onclick="app.setLoginRole('Teacher')" id="roleTab_Teacher" class="py-2 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900">
                            Teacher
                        </button>
                        <button type="button" onclick="app.setLoginRole('Admin')" id="roleTab_Admin" class="py-2 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900">
                            Admin
                        </button>
                    </div>

                    <!-- Login Form -->
                    <form onsubmit="app.handleLogin(event)" class="space-y-4">
                        <div>
                            <label id="loginIdLabel" for="loginIdInput" class="block text-xs font-medium text-slate-700 mb-1.5">Student ID</label>
                            <input type="text" id="loginIdInput" required autocomplete="off" placeholder="Enter your ID"
                                class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition">
                        </div>

                        <div>
                            <label for="loginPwInput" class="block text-xs font-medium text-slate-700 mb-1.5">Password</label>
                            <input type="password" id="loginPwInput" required placeholder="Enter your password"
                                class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition">
                        </div>

                        <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow-sm transition flex items-center justify-center gap-2">
                            <span>Sign In</span>
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                    </form>

                    <!-- Subtle Help Link -->
                    <div class="pt-2 border-t border-slate-100 text-center">
                        <button type="button" onclick="app.toggleHelpModal(true)" class="text-xs text-slate-400 hover:text-indigo-600 transition inline-flex items-center gap-1.5">
                            <i class="fa-regular fa-circle-question"></i>
                            <span>System Credentials Reference</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- ================= VIEW 2: STUDENT DASHBOARD ================= -->
            <section id="viewStudentDashboard" class="hidden space-y-6 max-w-3xl mx-auto">
                <!-- Welcome Banner -->
                <div class="bg-white border border-slate-200 rounded-2xl p-6 flex flex-wrap items-center justify-between gap-4 shadow-sm">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2.5">
                            <h2 id="stuDashName" class="text-xl font-bold text-slate-900">Student Name</h2>
                            <span id="stuDashStatusBadge" class="px-2.5 py-0.5 rounded-full text-xs font-medium">Not Taken</span>
                        </div>
                        <p id="stuDashMeta" class="text-xs text-slate-500 mono">ID: STU001 • Roll: DEMO</p>
                    </div>
                    <div class="text-right">
                        <span class="text-xs text-slate-400 block">Allocated Duration</span>
                        <span id="stuDashDuration" class="text-sm font-semibold text-slate-800 mono">30 Minutes</span>
                    </div>
                </div>

                <!-- Two Clean Cards: Take Exam & My Results -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Take Examination Card -->
                    <div class="bg-white border border-slate-200 rounded-2xl p-6 flex flex-col justify-between space-y-6 shadow-sm">
                        <div class="space-y-2">
                            <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </div>
                            <h3 class="text-base font-bold text-slate-900 pt-1">Examination Session</h3>
                            <p id="stuExamDesc" class="text-xs text-slate-500 leading-relaxed">
                                Start your timed examination. Your answers are automatically saved as you progress.
                            </p>
                        </div>

                        <button onclick="app.startExam()" id="btnStudentStartExam" class="w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition flex items-center justify-center gap-2">
                            <span>Start Examination</span>
                            <i class="fa-solid fa-play text-xs"></i>
                        </button>
                    </div>

                    <!-- My Result Card -->
                    <div class="bg-white border border-slate-200 rounded-2xl p-6 flex flex-col justify-between space-y-4 shadow-sm">
                        <div class="space-y-2">
                            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                                <i class="fa-solid fa-chart-simple"></i>
                            </div>
                            <h3 class="text-base font-bold text-slate-900 pt-1">Latest Result</h3>
                            <p class="text-xs text-slate-500">
                                View your graded score after submitting the examination.
                            </p>
                        </div>

                        <div id="stuResultContent" class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 min-h-[88px] flex items-center justify-center">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>
            </section>

            <!-- ================= VIEW 3: FOCUSED EXAM SESSION ================= -->
            <section id="viewExamSession" class="hidden space-y-6">
                <!-- Top Exam Control Bar -->
                <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:px-6 flex flex-wrap items-center justify-between gap-4 shadow-sm">
                    <div class="flex items-center gap-3">
                        <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-lg">Live Exam</span>
                        <span id="examSaveIndicator" class="text-xs text-slate-500 flex items-center gap-1.5">
                            <i class="fa-solid fa-cloud-arrow-up text-emerald-500"></i>
                            <span>All changes saved</span>
                        </span>
                    </div>

                    <div class="flex items-center gap-3">
                        <button onclick="app.promptSubmitExam()" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-sm transition flex items-center gap-2">
                            <i class="fa-solid fa-check"></i>
                            <span>Submit Exam</span>
                        </button>
                    </div>
                </div>

                <!-- Main Exam Grid: Question Card (8 cols) + Question Palette (4 cols) -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                    
                    <!-- Focused Single Question Card -->
                    <div class="lg:col-span-8 bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6">
                        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                            <div class="flex items-center gap-2.5">
                                <span id="examQBadge" class="px-3 py-1 rounded-lg bg-slate-900 text-white font-bold text-xs mono">Question 1</span>
                                <span id="examQType" class="text-xs text-slate-500 font-medium">Multiple Choice</span>
                            </div>
                            <button onclick="app.clearCurrentAnswer()" class="text-xs text-rose-600 hover:text-rose-700 font-medium flex items-center gap-1 transition">
                                <i class="fa-solid fa-rotate-left"></i>
                                <span>Clear Answer</span>
                            </button>
                        </div>

                        <!-- Question Text -->
                        <h3 id="examQText" class="text-lg font-semibold text-slate-900 leading-relaxed">
                            Question text goes here?
                        </h3>

                        <!-- Multiple Choice Options -->
                        <div id="examMcqContainer" class="space-y-2.5 pt-2">
                            <!-- Populated by JS -->
                        </div>

                        <!-- Written Answer Input -->
                        <div id="examWrittenContainer" class="hidden space-y-3 pt-2">
                            <textarea id="examWrittenInput" rows="4" placeholder="Type your answer here..."
                                oninput="app.saveWrittenDraft()"
                                class="w-full p-3.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 transition"></textarea>
                            <p class="text-[11px] text-slate-400">Your written response is saved automatically as you type.</p>
                        </div>

                        <!-- Previous / Next Navigation Footer -->
                        <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
                            <button onclick="app.prevQuestion()" id="btnPrevQ" class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold transition flex items-center gap-2 disabled:opacity-40 disabled:pointer-events-none">
                                <i class="fa-solid fa-arrow-left"></i>
                                <span>Previous</span>
                            </button>
                            <span id="examStepCounter" class="text-xs text-slate-400 font-medium">1 of 4</span>
                            <button onclick="app.nextQuestion()" id="btnNextQ" class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold transition flex items-center gap-2 disabled:opacity-40 disabled:pointer-events-none">
                                <span>Next</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Clean Question Palette Sidebar -->
                    <div class="lg:col-span-4 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-5">
                        <div>
                            <h4 class="text-sm font-bold text-slate-900">Question Palette</h4>
                            <p id="examProgressSub" class="text-xs text-slate-500 mt-0.5">0 of 4 answered</p>
                        </div>

                        <div id="examPaletteGrid" class="grid grid-cols-4 sm:grid-cols-5 lg:grid-cols-4 gap-2">
                            <!-- Question number buttons -->
                        </div>

                        <div class="pt-4 border-t border-slate-100 grid grid-cols-2 gap-2 text-[11px] text-slate-500">
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded bg-indigo-600 inline-block"></span>
                                <span>Current</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded bg-emerald-100 border border-emerald-300 inline-block"></span>
                                <span>Answered</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded bg-slate-100 border border-slate-200 inline-block"></span>
                                <span>Unanswered</span>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

            <!-- ================= VIEW 4: TEACHER PORTAL ================= -->
            <section id="viewTeacherPortal" class="hidden space-y-6">
                <!-- Portal Header & Navigation Tabs -->
                <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:px-6 flex flex-wrap items-center justify-between gap-4 shadow-sm">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">Teacher Dashboard</h2>
                        <p class="text-xs text-slate-500">Manage examination questions, timer settings, and student access</p>
                    </div>
                    <div class="flex bg-slate-100 p-1 rounded-xl">
                        <button onclick="app.switchTeacherTab('questions')" id="tTab_questions" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition bg-white text-slate-900 shadow-sm">
                            Questions
                        </button>
                        <button onclick="app.switchTeacherTab('students')" id="tTab_students" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900">
                            Student Status
                        </button>
                        <button onclick="app.switchTeacherTab('settings')" id="tTab_settings" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900">
                            Exam Settings
                        </button>
                    </div>
                </div>

                <!-- Teacher Tab 1: Questions Management -->
                <div id="teacherPanel_questions" class="space-y-6">
                    <div class="flex items-center justify-between">
                        <span id="teacherQTotalBadge" class="text-xs font-semibold text-slate-600">4 Questions in Bank</span>
                        <button onclick="app.openQuestionModal(-1)" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-sm transition flex items-center gap-2">
                            <i class="fa-solid fa-plus"></i>
                            <span>Add Question</span>
                        </button>
                    </div>

                    <div id="teacherQuestionsList" class="space-y-3">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Teacher Tab 2: Student Status & Re-exam -->
                <div id="teacherPanel_students" class="hidden">
                    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
                        <div class="p-5 border-b border-slate-100">
                            <h3 class="text-sm font-bold text-slate-900">Student Examination Status</h3>
                            <p class="text-xs text-slate-500 mt-0.5">Unlock students who have completed or interrupted their exam to allow a retake.</p>
                        </div>
                        <div id="teacherStudentsTable" class="divide-y divide-slate-100">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>

                <!-- Teacher Tab 3: Exam Duration Settings -->
                <div id="teacherPanel_settings" class="hidden max-w-md">
                    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                        <div>
                            <h3 class="text-base font-bold text-slate-900">Examination Duration</h3>
                            <p class="text-xs text-slate-500 mt-0.5">Set the countdown timer limit (in minutes) for students taking the exam.</p>
                        </div>
                        <form onsubmit="app.saveDuration(event)" class="space-y-4">
                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1.5">Duration (1 – 1440 minutes)</label>
                                <input type="number" id="teacherDurationInput" min="1" max="1440" required value="30"
                                    class="w-full px-3.5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-900 text-sm mono focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600">
                            </div>
                            <button type="submit" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold transition">
                                Save Duration
                            </button>
                        </form>
                    </div>
                </div>
            </section>

            <!-- ================= VIEW 5: ADMIN PORTAL ================= -->
            <section id="viewAdminPortal" class="hidden space-y-6">
                <!-- Admin Header & Navigation Tabs -->
                <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:px-6 flex flex-wrap items-center justify-between gap-4 shadow-sm">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">Administration Portal</h2>
                        <p class="text-xs text-slate-500">View results, inspect student answer sheets, manage registrations, and review logs</p>
                    </div>
                    <div class="flex flex-wrap bg-slate-100 p-1 rounded-xl gap-1">
                        <button onclick="app.switchAdminTab('results')" id="aTab_results" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition bg-white text-slate-900 shadow-sm">
                            Results
                        </button>
                        <button onclick="app.switchAdminTab('answers')" id="aTab_answers" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900">
                            Answer Sheets
                        </button>
                        <button onclick="app.switchAdminTab('students')" id="aTab_students" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900">
                            Manage Students
                        </button>
                        <button onclick="app.switchAdminTab('logs')" id="aTab_logs" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900">
                            Audit Log
                        </button>
                    </div>
                </div>

                <!-- Admin Tab 1: All Results -->
                <div id="adminPanel_results" class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">Submitted Examination Results</h3>
                            <p class="text-xs text-slate-500 mt-0.5">All graded student submissions</p>
                        </div>
                    </div>
                    <div id="adminResultsContainer" class="divide-y divide-slate-100">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Admin Tab 2: Student Answer Sheets -->
                <div id="adminPanel_answers" class="hidden bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                    <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-100">
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">Inspect Student Answer Sheet</h3>
                            <p class="text-xs text-slate-500 mt-0.5">View individual responses recorded during the exam</p>
                        </div>
                        <select id="adminStudentSelect" onchange="app.renderAdminAnswerSheet()"
                            class="px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-300 text-xs font-medium text-slate-800 focus:outline-none focus:border-indigo-600">
                        </select>
                    </div>
                    <div id="adminAnswerSheetContainer" class="space-y-2">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- Admin Tab 3: Manage & Register Students -->
                <div id="adminPanel_students" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                    <!-- Register Form -->
                    <div class="lg:col-span-5 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">Register New Student</h3>
                            <p class="text-xs text-slate-500 mt-0.5">Add a student to the server and local database</p>
                        </div>
                        <form onsubmit="app.adminRegisterStudent(event)" class="space-y-3">
                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">Student ID</label>
                                <input type="text" id="regStuId" required placeholder="e.g. STU005" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs mono">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">Full Name</label>
                                <input type="text" id="regStuName" required placeholder="e.g. Riya Sharma" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">Roll Number</label>
                                <input type="text" id="regStuRoll" required placeholder="e.g. CS-105" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs mono">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-700 mb-1">Password</label>
                                <input type="password" id="regStuPw" required placeholder="Create password" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs">
                            </div>
                            <button type="submit" class="w-full py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs transition">
                                Register Student
                            </button>
                        </form>
                    </div>

                    <!-- Registered Directory -->
                    <div class="lg:col-span-7 bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
                        <div class="p-5 border-b border-slate-100">
                            <h3 class="text-sm font-bold text-slate-900">Registered Students</h3>
                        </div>
