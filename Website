    <!-- APPLICATION LOGIC -->
    <script>
        const Util = {
            nowSec: () => Math.floor(Date.now() / 1000),
            clean: (s) => String(s || '').replace(/[|\r\n]/g, ' ').trim(),
            timeStr: (sec) => {
                const d = new Date(sec * 1000);
                const pad = (n) => String(n).padStart(2, '0');
                return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
            },
            fmtClock: (s) => {
                if (s < 0) s = 0;
                const pad = (n) => String(Math.floor(n)).padStart(2, '0');
                return `${pad(s / 3600)}:${pad((s % 3600) / 60)}:${pad(s % 60)}`;
            }
        };

        const app = {
            isOnline: true,
            loginRole: 'Student',
            currentUser: null,

            // Core Data (from C++ AppContext::seedDemo)
            durationMinutes: 30,
            questions: [
                { text: "What is 12 + 8?", opts: ["18", "20", "22", "24"], correct: "B", type: "M" },
                { text: "What is the capital of India?", opts: ["Mumbai", "New Delhi", "Kolkata", "Chennai"], correct: "B", type: "M" },
                { text: "Which planet is called the Red Planet?", opts: ["Venus", "Jupiter", "Mars", "Saturn"], correct: "C", type: "M" },
                { text: "Explain Encapsulation in OOP briefly.", opts: ["", "", "", ""], correct: "Data hiding", type: "W" }
            ],
            students: [
                { id: "STU001", name: "Demo Student 1", roll: "DEMO-01", status: 0, start: 0 },
                { id: "STU002", name: "Demo Student 2", roll: "DEMO-02", status: 0, start: 0 },
                { id: "STU003", name: "Demo Student 3", roll: "DEMO-03", status: 0, start: 0 },
                { id: "STU004", name: "Demo Student 4", roll: "DEMO-04", status: 0, start: 0 }
            ],
            results: [],
            answerSheets: {},
            auditLogs: [],

            // Active Exam State
            examActive: false,
            examDeadlineMs: 0,
            examInterval: null,
            currentQIndex: 0, // 0-based

            init() {
                this.logAudit("System initialized [ONLINE]");
                this.setLoginRole('Student');
            },

            toast(message, type = 'info') {
                const container = document.getElementById('toastContainer');
                const el = document.createElement('div');
                const styles = {
                    info: 'bg-slate-900 text-white border-slate-800',
                    success: 'bg-emerald-600 text-white border-emerald-700',
                    warn: 'bg-amber-500 text-white border-amber-600',
                    error: 'bg-rose-600 text-white border-rose-700'
                };
                el.className = `pointer-events-auto px-4 py-3 rounded-xl border shadow-lg text-xs font-medium flex items-center justify-between gap-3 transition-all duration-300 ${styles[type] || styles.info}`;
                el.innerHTML = `<span>${message}</span>`;
                container.appendChild(el);
                setTimeout(() => {
                    el.style.opacity = '0';
                    setTimeout(() => el.remove(), 250);
                }, 3200);
            },

            logAudit(event) {
                this.auditLogs.unshift(`${Util.timeStr(Util.nowSec())} | ${event}`);
            },

            toggleNetwork() {
                this.isOnline = !this.isOnline;
                const pill = document.getElementById('netStatusPill');
                const dot = document.getElementById('netStatusDot');
                const label = document.getElementById('netStatusLabel');
                const saveInd = document.getElementById('examSaveIndicator');

                if (this.isOnline) {
                    pill.className = "flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium border transition bg-emerald-50 border-emerald-200 text-emerald-700 hover:bg-emerald-100";
                    dot.className = "w-2 h-2 rounded-full bg-emerald-500";
                    label.textContent = "Online";
                    if (saveInd) saveInd.innerHTML = `<i class="fa-solid fa-cloud-arrow-up text-emerald-500"></i><span>Synced to server</span>`;
                    this.logAudit("Network switched to ONLINE");
                    this.toast("Connected to central server (Online Mode)", "success");
                } else {
                    pill.className = "flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium border transition bg-amber-50 border-amber-200 text-amber-700 hover:bg-amber-100";
                    dot.className = "w-2 h-2 rounded-full bg-amber-500";
                    label.textContent = "Offline (Local)";
                    if (saveInd) saveInd.innerHTML = `<i class="fa-solid fa-hard-drive text-amber-500"></i><span>Saved locally (Offline)</span>`;
                    this.logAudit("Network switched to OFFLINE (Local cache active)");
                    this.toast("Switched to Offline Mode — Local auto-save active", "warn");
                }
            },

            toggleHelpModal(show) {
                document.getElementById('helpModal').classList.toggle('hidden', !show);
            },

            // --- Authentication ---
            setLoginRole(role) {
                this.loginRole = role;
                ['Student', 'Teacher', 'Admin'].forEach(r => {
                    const btn = document.getElementById('roleTab_' + r);
                    if (r === role) {
                        btn.className = "py-2 rounded-lg text-xs font-semibold transition bg-white text-slate-900 shadow-sm";
                    } else {
                        btn.className = "py-2 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900";
                    }
                });
                document.getElementById('loginIdLabel').textContent = `${role} ID`;
                document.getElementById('loginIdInput').value = '';
                document.getElementById('loginPwInput').value = '';
                document.getElementById('loginIdInput').focus();
            },

            handleLogin(e) {
                e.preventDefault();
                const id = document.getElementById('loginIdInput').value.trim();
                const pw = document.getElementById('loginPwInput').value;

                if (!id || !pw) {
                    this.toast("Please enter both ID and password.", "error");
                    return;
                }

                if (this.loginRole === 'Student') {
                    const stu = this.students.find(s => s.id.toLowerCase() === id.toLowerCase());
                    if (!stu) {
                        this.logAudit(`Login failed (Student): ${id}`);
                        this.toast("Student ID not found.", "error");
                        return;
                    }
                    this.currentUser = { role: 'Student', id: stu.id, name: stu.name, roll: stu.roll };
                    this.logAudit(`Student logged in: ${stu.id}`);
                    this.enterPortal('viewStudentDashboard');
                    this.renderStudentDashboard();
                } else if (this.loginRole === 'Teacher') {
                    if ((id === '890teach' || id === '890mik') && (pw === 'teacher123' || pw === 'admin123')) {
                        this.currentUser = { role: 'Teacher', id, name: 'Instructor' };
                        this.logAudit(`Teacher logged in: ${id}`);
                        this.enterPortal('viewTeacherPortal');
                        this.switchTeacherTab('questions');
                    } else {
                        this.logAudit("Login failed (Teacher)");
                        this.toast("Invalid Teacher credentials.", "error");
                    }
                } else if (this.loginRole === 'Admin') {
                    if ((id === 'admin_sys' || id === 'Mikhael@123') && (pw === 'admin123' || pw === 'master123')) {
                        this.currentUser = { role: 'Admin', id, name: 'Administrator' };
                        this.logAudit(`Admin logged in: ${id}`);
                        this.enterPortal('viewAdminPortal');
                        this.switchAdminTab('results');
                    } else {
                        this.logAudit("Login failed (Admin)");
                        this.toast("Invalid Admin credentials.", "error");
                    }
                }
            },

            enterPortal(viewId) {
                ['viewLogin', 'viewStudentDashboard', 'viewExamSession', 'viewTeacherPortal', 'viewAdminPortal'].forEach(v => {
                    document.getElementById(v).classList.add('hidden');
                });
                document.getElementById(viewId).classList.remove('hidden');

                const userArea = document.getElementById('headerUserArea');
                if (this.currentUser) {
                    userArea.classList.remove('hidden');
                    userArea.classList.add('flex');
                    document.getElementById('headerUserName').textContent = this.currentUser.name;
                    document.getElementById('headerUserRole').textContent = `${this.currentUser.role} (${this.currentUser.id})`;
                } else {
                    userArea.classList.add('hidden');
                    userArea.classList.remove('flex');
                }
            },

            logout() {
                if (this.examActive) this.stopWatchdog();
                if (this.currentUser) {
                    this.logAudit(`${this.currentUser.role} logged out: ${this.currentUser.id}`);
                }
                this.currentUser = null;
                this.setLoginRole('Student');
                this.enterPortal('viewLogin');
            },

            // --- Student Portal ---
            renderStudentDashboard() {
                const stu = this.students.find(s => s.id === this.currentUser.id);
                if (!stu) return;

                document.getElementById('stuDashName').textContent = stu.name;
                document.getElementById('stuDashMeta').textContent = `ID: ${stu.id} • Roll: ${stu.roll}`;
                document.getElementById('stuDashDuration').textContent = `${this.durationMinutes} Minutes`;

                const badge = document.getElementById('stuDashStatusBadge');
                const btn = document.getElementById('btnStudentStartExam');
                const desc = document.getElementById('stuExamDesc');

                if (stu.status === 0) {
                    badge.textContent = "Not Taken";
                    badge.className = "px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600";
                    btn.disabled = false;
                    btn.className = "w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm transition flex items-center justify-center gap-2";
                    btn.innerHTML = `<span>Start Examination</span><i class="fa-solid fa-play text-xs"></i>`;
                    desc.textContent = "Start your timed examination. Your answers are automatically saved as you progress.";
                } else if (stu.status === 1) {
                    badge.textContent = "In Progress";
                    badge.className = "px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800";
                    btn.disabled = false;
                    btn.className = "w-full py-2.5 px-4 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-semibold text-sm transition flex items-center justify-center gap-2";
                    btn.innerHTML = `<span>Resume Examination</span><i class="fa-solid fa-rotate-right text-xs"></i>`;
                    desc.textContent = "Your examination session is currently in progress. Click below to resume where you left off.";
                } else {
                    badge.textContent = "Completed";
                    badge.className = "px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800";
                    btn.disabled = true;
                    btn.className = "w-full py-2.5 px-4 rounded-xl bg-slate-100 text-slate-400 font-semibold text-sm cursor-not-allowed flex items-center justify-center gap-2";
                    btn.innerHTML = `<i class="fa-solid fa-lock text-xs"></i><span>Examination Submitted</span>`;
                    desc.textContent = "You have completed and submitted this examination. Contact your teacher if a retake is required.";
                }

                const myResults = this.results.filter(r => r.id === stu.id);
                const latest = myResults[myResults.length - 1];
                const resBox = document.getElementById('stuResultContent');

                if (!latest) {
                    resBox.innerHTML = `<span class="text-xs text-slate-400">No graded result available yet.</span>`;
                } else {
                    const pct = Math.round((latest.score / latest.total) * 100);
                    resBox.innerHTML = `
                        <div class="w-full flex items-center justify-between">
                            <div>
                                <div class="text-xs text-slate-500">Score Achieved</div>
                                <div class="text-2xl font-bold text-slate-900 mono mt-0.5">${latest.score} / ${latest.total} <span class="text-sm font-semibold text-emerald-600">(${pct}%)</span></div>
                            </div>
                            <span class="text-[11px] text-slate-400 mono">${Util.timeStr(latest.t)}</span>
                        </div>
                    `;
                }
            },

            // --- Focused Exam Session ---
            startExam() {
                const stu = this.students.find(s => s.id === this.currentUser.id);
                if (!stu || stu.status === 2) return;

                if (this.questions.length === 0) {
                    this.toast("No questions available in the exam bank.", "error");
                    return;
                }

                const now = Util.nowSec();
                if (stu.status === 0) {
                    stu.status = 1;
                    stu.start = now;
                }
                if (!this.answerSheets[stu.id]) {
                    this.answerSheets[stu.id] = {};
                }

                const remainSec = (stu.start + this.durationMinutes * 60) - now;
                if (remainSec <= 0) {
                    this.finishExam(true);
                    return;
                }

                this.examActive = true;
                this.examDeadlineMs = Date.now() + remainSec * 1000;
                this.currentQIndex = 0;

                document.getElementById('headerExamTimer').classList.remove('hidden');
                document.getElementById('headerExamTimer').classList.add('flex');

                this.logAudit(`Exam started/resumed: ${stu.id}`);
                this.enterPortal('viewExamSession');
                this.renderExamQuestion();
                this.startWatchdog();
            },

            startWatchdog() {
                if (this.examInterval) clearInterval(this.examInterval);
                this.examInterval = setInterval(() => {
                    if (!this.examActive) return;
                    const leftSec = Math.max(0, Math.ceil((this.examDeadlineMs - Date.now()) / 1000));
                    document.getElementById('headerTimerText').textContent = Util.fmtClock(leftSec);

                    if (leftSec <= 0) {
                        this.toast("Time is up! Submitting your examination automatically.", "warn");
                        this.finishExam(true);
                    }
                }, 250);
            },

            stopWatchdog() {
                this.examActive = false;
                if (this.examInterval) {
                    clearInterval(this.examInterval);
                    this.examInterval = null;
                }
                document.getElementById('headerExamTimer').classList.add('hidden');
                document.getElementById('headerExamTimer').classList.remove('flex');
            },

            renderExamQuestion() {
                const stuId = this.currentUser.id;
                const sheet = this.answerSheets[stuId] || {};
                const q = this.questions[this.currentQIndex];
                const qNum = this.currentQIndex + 1;
                const total = this.questions.length;

                document.getElementById('examQBadge').textContent = `Question ${qNum}`;
                document.getElementById('examQType').textContent = q.type === 'W' ? 'Written Response' : 'Multiple Choice';
                document.getElementById('examQText').textContent = q.text;
                document.getElementById('examStepCounter').textContent = `${qNum} of ${total}`;

                document.getElementById('btnPrevQ').disabled = (this.currentQIndex === 0);
                document.getElementById('btnNextQ').disabled = (this.currentQIndex === total - 1);

                const savedAns = sheet[qNum];
                const mcqBox = document.getElementById('examMcqContainer');
                const writtenBox = document.getElementById('examWrittenContainer');

                if (q.type === 'W') {
                    mcqBox.classList.add('hidden');
                    writtenBox.classList.remove('hidden');
                    document.getElementById('examWrittenInput').value = (savedAns && savedAns.text) ? savedAns.text : '';
                } else {
                    writtenBox.classList.add('hidden');
                    mcqBox.classList.remove('hidden');
                    const letters = ['A', 'B', 'C', 'D'];
                    mcqBox.innerHTML = letters.map((L, i) => {
                        const isSelected = savedAns && savedAns.choice === L;
                        return `
                            <button type="button" onclick="app.selectOption('${L}')"
                                class="w-full p-4 rounded-xl border text-left transition flex items-center justify-between ${isSelected ? 'bg-indigo-50/80 border-indigo-600 text-indigo-950 font-medium' : 'bg-white border-slate-200 hover:border-slate-300 text-slate-700'}">
                                <div class="flex items-center gap-3.5">
                                    <span class="w-7 h-7 rounded-lg flex items-center justify-center text-xs font-bold mono ${isSelected ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600'}">${L}</span>
                                    <span class="text-sm">${q.opts[i]}</span>
                                </div>
                                ${isSelected ? '<i class="fa-solid fa-circle-check text-indigo-600"></i>' : ''}
                            </button>
                        `;
                    }).join('');
                }

                // Render Palette
                let answeredCount = 0;
                const paletteHtml = this.questions.map((_, idx) => {
                    const num = idx + 1;
                    const ans = sheet[num];
                    const hasAns = ans && (ans.choice || ans.text);
                    if (hasAns) answeredCount++;

                    const isCurrent = (idx === this.currentQIndex);
                    let cls = "bg-slate-100 text-slate-600 border-slate-200 hover:bg-slate-200";
                    if (isCurrent) cls = "bg-indigo-600 text-white border-indigo-600 shadow-xs";
                    else if (hasAns) cls = "bg-emerald-50 text-emerald-700 border-emerald-300 font-semibold";

                    return `
                        <button type="button" onclick="app.jumpToQuestion(${idx})"
                            class="h-10 rounded-xl border text-xs mono font-medium transition ${cls}">
                            ${num}
                        </button>
                    `;
                }).join('');

                document.getElementById('examPaletteGrid').innerHTML = paletteHtml;
                document.getElementById('examProgressSub').textContent = `${answeredCount} of ${total} answered`;
            },

            selectOption(letter) {
                const stuId = this.currentUser.id;
                const qNum = this.currentQIndex + 1;
                this.answerSheets[stuId][qNum] = {
                    choice: letter,
                    text: '',
                    mode: this.isOnline ? 'ON' : 'OFF',
                    t: Util.nowSec(),
                    isWritten: false
                };
                this.renderExamQuestion();
            },

            saveWrittenDraft() {
                const stuId = this.currentUser.id;
                const qNum = this.currentQIndex + 1;
                const val = Util.clean(document.getElementById('examWrittenInput').value);
                if (!val) {
                    delete this.answerSheets[stuId][qNum];
                } else {
                    this.answerSheets[stuId][qNum] = {
                        choice: '',
                        text: val,
                        mode: this.isOnline ? 'ON' : 'OFF',
                        t: Util.nowSec(),
                        isWritten: true
                    };
                }
                // Update palette counts without losing textarea focus
                const sheet = this.answerSheets[stuId];
                let count = 0;
                this.questions.forEach((_, i) => {
                    const a = sheet[i + 1];
                    if (a && (a.choice || a.text)) count++;
                });
                document.getElementById('examProgressSub').textContent = `${count} of ${this.questions.length} answered`;
            },

            clearCurrentAnswer() {
                const stuId = this.currentUser.id;
                const qNum = this.currentQIndex + 1;
                if (this.answerSheets[stuId] && this.answerSheets[stuId][qNum]) {
                    delete this.answerSheets[stuId][qNum];
                    this.renderExamQuestion();
                    this.toast(`Cleared answer for Question ${qNum}`, "info");
                }
            },

            prevQuestion() {
                if (this.currentQIndex > 0) {
                    this.currentQIndex--;
                    this.renderExamQuestion();
                }
            },

            nextQuestion() {
                if (this.currentQIndex < this.questions.length - 1) {
                    this.currentQIndex++;
                    this.renderExamQuestion();
                }
            },

            jumpToQuestion(idx) {
                this.currentQIndex = idx;
                this.renderExamQuestion();
            },

            promptSubmitExam() {
                const sheet = this.answerSheets[this.currentUser.id] || {};
                let count = 0;
                this.questions.forEach((_, i) => {
                    if (sheet[i + 1] && (sheet[i + 1].choice || sheet[i + 1].text)) count++;
                });
                document.getElementById('submitModalStats').textContent = `You have answered ${count} of ${this.questions.length} questions.`;
                document.getElementById('submitExamModal').classList.remove('hidden');
            },

            closeSubmitModal() {
                document.getElementById('submitExamModal').classList.add('hidden');
            },

            finishExam(autoEnd = false) {
                this.closeSubmitModal();
                this.stopWatchdog();

                const stu = this.students.find(s => s.id === this.currentUser.id);
                const sheet = this.answerSheets[stu.id] || {};

                let score = 0;
                this.questions.forEach((q, idx) => {
                    const ans = sheet[idx + 1];
                    if (!ans) return;
                    if (q.type === 'W') {
                        const cleanAns = (ans.text || '').toLowerCase();
                        const cleanKey = (q.correct || '').toLowerCase();
                        if (cleanKey && cleanAns.includes(cleanKey)) score++;
                    } else {
                        if (ans.choice === q.correct) score++;
                    }
                });

                this.results.push({
                    id: stu.id,
                    name: stu.name,
                    roll: stu.roll,
                    score,
                    total: this.questions.length,
                    t: Util.nowSec()
                });

                stu.status = 2; // Completed
                stu.start = 0;

                this.logAudit(`Exam submitted: ${stu.id} scored ${score}/${this.questions.length}${autoEnd ? ' (time expired)' : ''}`);
                this.toast(`Exam submitted! Score: ${score} / ${this.questions.length}`, "success");

                this.enterPortal('viewStudentDashboard');
                this.renderStudentDashboard();
            },

            // --- Teacher Portal ---
            switchTeacherTab(tab) {
                ['questions', 'students', 'settings'].forEach(t => {
                    document.getElementById('teacherPanel_' + t).classList.toggle('hidden', t !== tab);
                    const btn = document.getElementById('tTab_' + t);
                    if (t === tab) {
                        btn.className = "px-3.5 py-1.5 rounded-lg text-xs font-semibold transition bg-white text-slate-900 shadow-sm";
                    } else {
                        btn.className = "px-3.5 py-1.5 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900";
                    }
                });
                this.renderTeacherPortal();
            },

            renderTeacherPortal() {
                document.getElementById('teacherQTotalBadge').textContent = `${this.questions.length} Questions in Bank`;
                document.getElementById('teacherDurationInput').value = this.durationMinutes;

                // Questions list
                const qList = document.getElementById('teacherQuestionsList');
                if (this.questions.length === 0) {
                    qList.innerHTML = `<div class="bg-white border border-slate-200 rounded-2xl p-8 text-center text-xs text-slate-400">No questions in the bank. Click "Add Question" to create one.</div>`;
                } else {
                    qList.innerHTML = this.questions.map((q, i) => `
                        <div class="bg-white border border-slate-200 rounded-2xl p-5 flex flex-wrap items-center justify-between gap-4 shadow-xs">
                            <div class="space-y-1 max-w-2xl">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold mono text-slate-400">#${i + 1}</span>
                                    <span class="px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${q.type === 'W' ? 'bg-amber-50 text-amber-700' : 'bg-indigo-50 text-indigo-700'}">${q.type === 'W' ? 'Written' : 'MCQ'}</span>
                                    <h4 class="text-sm font-semibold text-slate-900">${q.text}</h4>
                                </div>
                                <p class="text-xs text-slate-500 pl-6">
                                    ${q.type === 'W'
                                        ? `Expected Keyword: <span class="font-medium text-slate-800">"${q.correct}"</span>`
                                        : `A) ${q.opts[0]} &bull; B) ${q.opts[1]} &bull; C) ${q.opts[2]} &bull; D) ${q.opts[3]} &mdash; <span class="font-semibold text-emerald-700">Answer: ${q.correct}</span>`}
                                </p>
                            </div>
                            <div class="flex items-center gap-2">
                                <button onclick="app.openQuestionModal(${i})" class="px-3 py-1.5 rounded-xl border border-slate-200 hover:bg-slate-50 text-xs font-medium text-slate-700 transition">
                                    Edit
                                </button>
                                <button onclick="app.deleteQuestion(${i})" class="px-3 py-1.5 rounded-xl border border-rose-200 hover:bg-rose-50 text-xs font-medium text-rose-600 transition">
                                    Delete
                                </button>
                            </div>
                        </div>
                    `).join('');
                }

                // Students table
                const sTable = document.getElementById('teacherStudentsTable');
                sTable.innerHTML = this.students.map(s => {
                    const statusLabel = s.status === 0 ? 'Not Taken' : s.status === 1 ? 'In Progress' : 'Blocked (Completed)';
                    const statusBadge = s.status === 0
                        ? 'bg-slate-100 text-slate-600'
                        : s.status === 1
                            ? 'bg-amber-100 text-amber-800'
                            : 'bg-rose-100 text-rose-700';

                    return `
                        <div class="p-4 sm:px-6 flex flex-wrap items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <span class="text-xs font-bold mono text-slate-900">${s.id}</span>
                                <span class="text-sm text-slate-700">${s.name}</span>
                                <span class="text-xs text-slate-400 mono">(${s.roll})</span>
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium ${statusBadge}">${statusLabel}</span>
                            </div>
                            <div>
                                ${s.status !== 0 ? `
                                    <button onclick="app.allowReExam('${s.id}')" class="px-3.5 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 text-xs font-semibold transition">
                                        Allow Re-exam
                                    </button>
                                ` : `<span class="text-xs text-slate-400">Eligible</span>`}
                            </div>
                        </div>
                    `;
                }).join('');
            },

            openQuestionModal(index = -1) {
                document.getElementById('qModalIndex').value = index;
                if (index >= 0) {
                    const q = this.questions[index];
                    document.getElementById('qModalTitle').textContent = `Edit Question #${index + 1}`;
                    document.getElementById('qModalType').value = q.type;
                    document.getElementById('qModalText').value = q.text;
                    document.getElementById('qOptA').value = q.opts[0] || '';
                    document.getElementById('qOptB').value = q.opts[1] || '';
                    document.getElementById('qOptC').value = q.opts[2] || '';
                    document.getElementById('qOptD').value = q.opts[3] || '';
                    if (q.type === 'W') {
                        document.getElementById('qModalCorrectWritten').value = q.correct;
                    } else {
                        document.getElementById('qModalCorrectMcq').value = q.correct;
                    }
                } else {
                    document.getElementById('qModalTitle').textContent = 'Add New Question';
                    document.getElementById('qModalType').value = 'M';
                    document.getElementById('qModalText').value = '';
                    document.getElementById('qOptA').value = '';
                    document.getElementById('qOptB').value = '';
                    document.getElementById('qOptC').value = '';
                    document.getElementById('qOptD').value = '';
                    document.getElementById('qModalCorrectWritten').value = '';
                }
                this.toggleQuestionModalType();
                document.getElementById('questionModal').classList.remove('hidden');
            },

            closeQuestionModal() {
                document.getElementById('questionModal').classList.add('hidden');
            },

            toggleQuestionModalType() {
                const isW = document.getElementById('qModalType').value === 'W';
                document.getElementById('qModalMcqSection').classList.toggle('hidden', isW);
                document.getElementById('qModalWrittenSection').classList.toggle('hidden', !isW);
            },

            saveQuestionForm(e) {
                e.preventDefault();
                const idx = parseInt(document.getElementById('qModalIndex').value, 10);
                const type = document.getElementById('qModalType').value;
                const text = Util.clean(document.getElementById('qModalText').value);

                let item;
                if (type === 'W') {
                    const key = Util.clean(document.getElementById('qModalCorrectWritten').value);
                    if (!key) { this.toast("Please enter an expected keyword.", "error"); return; }
                    item = { text, opts: ["", "", "", ""], correct: key, type: 'W' };
                } else {
                    const a = Util.clean(document.getElementById('qOptA').value);
                    const b = Util.clean(document.getElementById('qOptB').value);
                    const c = Util.clean(document.getElementById('qOptC').value);
                    const d = Util.clean(document.getElementById('qOptD').value);
                    const key = document.getElementById('qModalCorrectMcq').value;
                    if (!a || !b || !c || !d) { this.toast("Please fill in all 4 options.", "error"); return; }
                    item = { text, opts: [a, b, c, d], correct: key, type: 'M' };
                }

                if (idx >= 0) {
                    this.questions[idx] = item;
                    this.logAudit(`Teacher updated question #${idx + 1}`);
                    this.toast("Question updated.", "success");
                } else {
                    this.questions.push(item);
                    this.logAudit("Teacher added a new question");
                    this.toast("Question added.", "success");
                }
                this.closeQuestionModal();
                this.renderTeacherPortal();
            },

            deleteQuestion(idx) {
                this.questions.splice(idx, 1);
                this.logAudit(`Teacher deleted question #${idx + 1}`);
                this.toast("Question deleted.", "info");
                this.renderTeacherPortal();
            },

            saveDuration(e) {
                e.preventDefault();
                const m = parseInt(document.getElementById('teacherDurationInput').value, 10);
                if (m >= 1 && m <= 1440) {
                    this.durationMinutes = m;
                    this.logAudit(`Teacher set duration to ${m} minutes`);
                    this.toast(`Exam duration set to ${m} minutes.`, "success");
                }
            },

            allowReExam(stuId) {
                const stu = this.students.find(s => s.id === stuId);
                if (!stu) return;
                stu.status = 0;
                stu.start = 0;
                delete this.answerSheets[stuId];
                this.logAudit(`Teacher allowed re-exam for ${stuId}`);
                this.toast(`Unlocked ${stuId} for re-examination.`, "success");
                this.renderTeacherPortal();
            },

            // --- Admin Portal ---
            switchAdminTab(tab) {
                ['results', 'answers', 'students', 'logs'].forEach(t => {
                    document.getElementById('adminPanel_' + t).classList.toggle('hidden', t !== tab);
                    const btn = document.getElementById('aTab_' + t);
                    if (t === tab) {
                        btn.className = "px-3.5 py-1.5 rounded-lg text-xs font-semibold transition bg-white text-slate-900 shadow-sm";
                    } else {
                        btn.className = "px-3.5 py-1.5 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900";
                    }
                });
                this.renderAdminPortal();
            },

            renderAdminPortal() {
                // Results list
                const resBox = document.getElementById('adminResultsContainer');
                if (this.results.length === 0) {
                    resBox.innerHTML = `<div class="p-8 text-center text-xs text-slate-400">No examination results recorded yet.</div>`;
                } else {
                    resBox.innerHTML = this.results.map(r => `
                        <div class="p-4 sm:px-6 flex items-center justify-between">
                            <div>
                                <span class="text-xs font-bold mono text-indigo-600">${r.id}</span>
                                <span class="text-sm font-medium text-slate-900 ml-2">${r.name}</span>
                                <span class="text-xs text-slate-400 mono ml-1">(${r.roll})</span>
                                <div class="text-[11px] text-slate-400 mt-0.5">${Util.timeStr(r.t)}</div>
                            </div>
                            <span class="px-3 py-1 rounded-xl bg-emerald-50 text-emerald-700 font-bold text-xs mono">${r.score} / ${r.total}</span>
                        </div>
                    `).join('');
                }

                // Answer Sheet Student Selector
                const sel = document.getElementById('adminStudentSelect');
                const currentVal = sel.value;
                sel.innerHTML = this.students.map(s => `<option value="${s.id}">${s.id} — ${s.name}</option>`).join('');
                if (currentVal && this.students.some(s => s.id === currentVal)) sel.value = currentVal;
                this.renderAdminAnswerSheet();

                // Student Directory
                const dir = document.getElementById('adminStudentDirectory');
                dir.innerHTML = this.students.map(s => `
                    <div class="p-4 sm:px-5 flex items-center justify-between text-xs">
                        <div>
                            <span class="font-bold mono text-slate-900">${s.id}</span>
                            <span class="text-slate-700 ml-2">${s.name}</span>
                        </div>
                        <span class="text-slate-400 mono">${s.roll}</span>
                    </div>
                `).join('');

                // Audit Log
                const logBox = document.getElementById('adminAuditLogBox');
                logBox.innerHTML = this.auditLogs.map(l => `<div>${l}</div>`).join('');
            },

            renderAdminAnswerSheet() {
                const stuId = document.getElementById('adminStudentSelect').value;
                const container = document.getElementById('adminAnswerSheetContainer');
                const sheet = this.answerSheets[stuId];

                if (!sheet || Object.keys(sheet).length === 0) {
                    container.innerHTML = `<div class="p-6 text-center text-xs text-slate-400 bg-slate-50 rounded-xl">No recorded answers found for ${stuId}.</div>`;
                    return;
                }

                container.innerHTML = Object.keys(sheet).map(qNum => {
                    const a = sheet[qNum];
                    return `
                        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 flex items-center justify-between text-xs">
                            <div>
                                <span class="font-bold mono text-slate-700">Question ${qNum}:</span>
                                <span class="ml-2 font-semibold text-indigo-700">${a.isWritten ? `"${a.text}"` : `Option ${a.choice}`}</span>
                            </div>
                            <span class="text-[11px] text-slate-400 mono">Mode: ${a.mode} &bull; ${Util.timeStr(a.t)}</span>
                        </div>
                    `;
                }).join('');
            },

            adminRegisterStudent(e) {
                e.preventDefault();
                const id = Util.clean(document.getElementById('regStuId').value);
                const name = Util.clean(document.getElementById('regStuName').value);
                const roll = Util.clean(document.getElementById('regStuRoll').value);

                if (this.students.some(s => s.id.toLowerCase() === id.toLowerCase())) {
                    this.toast("Student ID already exists.", "error");
                    return;
                }

                this.students.push({ id, name, roll, status: 0, start: 0 });
                this.logAudit(`Admin registered student ${id}`);
                this.toast(`Student ${id} registered.`, "success");

                document.getElementById('regStuId').value = '';
                document.getElementById('regStuName').value = '';
                document.getElementById('regStuRoll').value = '';
                document.getElementById('regStuPw').value = '';
                this.renderAdminPortal();
            }
        };

        window.addEventListener('DOMContentLoaded', () => app.init());
    </script>
</body>
</html>
